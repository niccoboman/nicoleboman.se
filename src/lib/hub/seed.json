  },
  {
   "status": "ide",
   "typ": "film",
   "format": null,
   "pelare": "omdome",
   "text": "",
   "anteckning": "Krok i serien Frågan före verktyget",
   "fil": null,
   "planerad": null,
   "postad": null,
   "titel": "En vd frågade vilken AI de skulle köpa. Jag svarade med en annan fråga."
  },
  {
   "status": "ide",
   "typ": "film",
   "format": null,
   "pelare": "omdome",
   "text": "",
   "anteckning": "Krok i serien Frågan före verktyget",
   "fil": null,
   "planerad": null,
   "postad": null,
   "titel": "Det första en ledningsgrupp frågar mig är aldrig vilket verktyg. Det är vem som får säga nej."
  },
  {
   "status": "ide",
   "typ": "film",
   "format": null,
   "pelare": "omdome",
   "text": "",
   "anteckning": "Krok i serien Frågan före verktyget",
   "fil": null,
   "planerad": null,
   "postad": null,
   "titel": "En ledningsgrupp frågade mig: ska vi förbjuda ChatGPT? Här är vad jag svarade."
  },
  {
   "status": "ide",
   "typ": "film",
   "format": null,
   "pelare": "omdome",
   "text": "\"Myt: en AI-agent är bara en chattbot.\" Koppla varje myt till ett beslut.",
   "anteckning": "",
   "fil": null,
   "planerad": null,
   "postad": null,
   "titel": "Agent-myter"
  },
  {
   "status": "ide",
   "typ": "film",
   "format": null,
   "pelare": "omdome",
   "text": "\"Er AI-policy förbjuder förmodligen det som era medarbetare redan gör varje dag.\"",
   "anteckning": "",
   "fil": null,
   "planerad": null,
   "postad": null,
   "titel": "Er AI-policy"
  },
  {
   "status": "ide",
   "typ": "film",
   "format": null,
   "pelare": "omdome",
   "text": "\"Sluta köpa AI-licenser om ni vill att folk ska använda AI.\"",
   "anteckning": "",
   "fil": null,
   "planerad": null,
   "postad": null,
   "titel": "Tvärtom"
  },
  {
   "status": "ide",
   "typ": "film",
   "format": null,
   "pelare": "omdome",
   "text": "Vad andra AI-röster missar eller har fel om (stitcha gärna).",
   "anteckning": "",
   "fil": null,
   "planerad": null,
   "postad": null,
   "titel": "Det ingen i Sverige säger om AI"
  },
  {
   "status": "ide",
   "typ": "film",
   "format": null,
   "pelare": "jobbet",
   "text": "(klippt film). Händer, skärmar, ryggar, hennes röst.",
   "anteckning": "",
   "fil": null,
   "planerad": null,
   "postad": null,
   "titel": "Kursdag bakom kulisserna"
  },
  {
   "status": "ide",
   "typ": "film",
   "format": null,
   "pelare": "jobbet",
   "text": "\"Mitt jobb fanns inte för tre år sen. Så här ser en vecka ut.\"",
   "anteckning": "",
   "fil": null,
   "planerad": null,
   "postad": null,
   "titel": "Vad en AI-rådgivare faktiskt gör"
  },
  {
   "status": "ide",
   "typ": "film",
   "format": null,
   "pelare": "jobbet",
   "text": "\"Så här ser de första 20 minuterna ut när jag kommer till ett företag som inte vet var de ska börja med AI.\"",
   "anteckning": "",
   "fil": null,
   "planerad": null,
   "postad": null,
   "titel": "De första 20 minuterna"
  },
  {
   "status": "ide",
   "typ": "film",
   "format": null,
   "pelare": "jobbet",
   "text": "Efter varje kurs: den vanligaste frågan, besvarad i bilen hem.",
   "anteckning": "",
   "fil": null,
   "planerad": null,
   "postad": null,
   "titel": "Frågan alla deltagare ställer"
  },
  {
   "status": "ide",
   "typ": "film",
   "format": null,
   "pelare": "jobbet",
   "text": "30–60 s från scen. Kräver att någon filmar.",
   "anteckning": "",
   "fil": null,
   "planerad": null,
   "postad": null,
   "titel": "Keynote-utdrag"
  },
  {
   "status": "ide",
   "typ": "film",
   "format": null,
   "pelare": "jobbet",
   "text": "\"Klockan nio trodde hon att agenter var magi. Klockan tre hade hon byggt en.\" Kräver samtycke.",
   "anteckning": "",
   "fil": null,
   "planerad": null,
   "postad": null,
   "titel": "Från magi till byggt"
  },
  {
   "status": "ide",
   "typ": "film",
   "format": null,
   "pelare": "agenter",
   "text": "\"Det här mejlet skrev en AI-agent åt mig i morse, och jag har inte rört det.\"",
   "anteckning": "",
   "fil": null,
   "planerad": null,
   "postad": null,
   "titel": "Mejlet agenten skrev"
  },
  {
   "status": "ide",
   "typ": "film",
   "format": null,
   "pelare": "agenter",
   "text": "Var det gick fel och var hon satte stopp.",
   "anteckning": "",
   "fil": null,
   "planerad": null,
   "postad": null,
   "titel": "Jag gav en agent min inkorg"
  },
  {
   "status": "ide",
   "typ": "film",
   "format": null,
   "pelare": "agenter",
   "text": "Hur hon låter AI ta det hennes hjärna inte vill hålla i.",
   "anteckning": "",
   "fil": null,
   "planerad": null,
   "postad": null,
   "titel": "ADHD och agenter"
  },
  {
   "status": "ide",
   "typ": "film",
   "format": null,
   "pelare": "agenter",
   "text": "Röstverktygen.",
   "anteckning": "",
   "fil": null,
   "planerad": null,
   "postad": null,
   "titel": "Jag skriver inte längre, jag pratar"
  },
  {
   "status": "ide",
   "typ": "film",
   "format": null,
   "pelare": "skarm",
   "text": "\"Jag automatiserar åt företag. Här är tre saker jag vägrar automatisera.\"",
   "anteckning": "",
   "fil": null,
   "planerad": null,
   "postad": null,
   "titel": "Det jag vägrar automatisera"
  },
  {
   "status": "ide",
   "typ": "film",
   "format": null,
   "pelare": "skarm",
   "text": "Promenaden där jobbet blir gjort.",
   "anteckning": "",
   "fil": null,
   "planerad": null,
   "postad": null,
   "titel": "En arbetsdag utan skärm"
  },
  {
   "status": "ide",
   "typ": "film",
